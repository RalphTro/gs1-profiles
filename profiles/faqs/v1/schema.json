{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ralphtro.github.io/gs1-profiles/profiles/faqs/v1/schema.json",
  "title": "GS1 FAQ resource (gs1:faqs link type target)",
  "description": "JSON Schema for FAQ resources returned when dereferencing a GS1 Digital Link qualified with the gs1:faqs link type. The resource MAY be represented either as a single FAQPage root object or as a JSON-LD @graph containing one or more FAQPage nodes.",
  "type": "object",
  "required": [
    "@context"
  ],
  "properties": {
    "@context": {
      "$ref": "#/$defs/context"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/faqPage"
    },
    {
      "$ref": "#/$defs/graphDocument"
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "typeValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "context": {
      "description": "JSON-LD context. It MUST include https://schema.org. Additional URI contexts and inline context definitions MAY be included.",
      "oneOf": [
        {
          "type": "string",
          "const": "https://schema.org"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    },
                    {
                      "type": "array"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            ]
          },
          "contains": {
            "type": "string",
            "const": "https://schema.org"
          },
          "minContains": 1
        }
      ]
    },
    "uriReference": {
      "type": "object",
      "required": [
        "@id"
      ],
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "brand": {
      "type": "object",
      "anyOf": [
        {
          "$ref": "#/$defs/uriReference"
        },
        {
          "required": [
            "@type",
            "name"
          ],
          "properties": {
            "@id": {
              "type": "string",
              "format": "uri"
            },
            "@type": {
              "const": "Brand"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "required": [
        "@type",
        "gtin",
        "name"
      ],
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+/01/[0-9]{14}(/.*)?$",
          "description": "GS1 Digital Link URI identifying the product. The GTIN component MUST be expressed as 14 digits."
        },
        "@type": {
          "oneOf": [
            {
              "const": "Product"
            },
            {
              "type": "array",
              "minItems": 1,
              "contains": {
                "const": "Product"
              }
            }
          ]
        },
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{14}$",
          "description": "GTIN expressed as 14 digits."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "$ref": "#/$defs/brand"
        }
      },
      "additionalProperties": true
    },
    "about": {
      "description": "The entity the FAQ page is about. It MAY be represented as an @id reference or as a fully embedded entity.",
      "anyOf": [
        {
          "$ref": "#/$defs/uriReference"
        },
        {
          "$ref": "#/$defs/product"
        },
        {
          "type": "object",
          "required": [
            "@type",
            "name"
          ],
          "properties": {
            "@id": {
              "type": "string",
              "format": "uri"
            },
            "@type": {
              "$ref": "#/$defs/typeValue"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "organization": {
      "type": "object",
      "required": [
        "@type",
        "name"
      ],
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "@type": {
          "const": "Organization"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "publisher": {
      "description": "The publisher of the FAQ page. It MAY be represented as an @id reference or as a fully embedded Organization.",
      "anyOf": [
        {
          "$ref": "#/$defs/uriReference"
        },
        {
          "$ref": "#/$defs/organization"
        }
      ]
    },
    "propertyValue": {
      "type": "object",
      "required": [
        "@type",
        "name",
        "value"
      ],
      "properties": {
        "@type": {
          "const": "PropertyValue"
        },
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "additionalProperties": true
    },
    "answer": {
      "type": "object",
      "required": [
        "@type",
        "text"
      ],
      "properties": {
        "@type": {
          "const": "Answer"
        },
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "inLanguage": {
          "$ref": "#/$defs/languageTag"
        },
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/uriReference"
            },
            {
              "$ref": "#/$defs/organization"
            }
          ]
        },
        "dateModified": {
          "type": "string",
          "format": "date"
        },
        "additionalProperty": {
          "oneOf": [
            {
              "$ref": "#/$defs/propertyValue"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/propertyValue"
              }
            }
          ]
        },
        "citation": {
          "oneOf": [
            {
              "$ref": "#/$defs/uriReference"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/uriReference"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "question": {
      "type": "object",
      "required": [
        "@type",
        "name",
        "acceptedAnswer"
      ],
      "properties": {
        "@type": {
          "const": "Question"
        },
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inLanguage": {
          "$ref": "#/$defs/languageTag"
        },
        "alternateName": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "acceptedAnswer": {
          "$ref": "#/$defs/answer"
        }
      },
      "additionalProperties": true
    },
    "faqPage": {
      "type": "object",
      "required": [
        "@type",
        "@id",
        "about",
        "mainEntity"
      ],
      "properties": {
        "@context": {
          "$ref": "#/$defs/context"
        },
        "@type": {
          "oneOf": [
            {
              "const": "FAQPage"
            },
            {
              "type": "array",
              "minItems": 1,
              "contains": {
                "const": "FAQPage"
              }
            }
          ]
        },
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "inLanguage": {
          "$ref": "#/$defs/languageTag"
        },
        "about": {
          "$ref": "#/$defs/about"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "mainEntity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "additionalProperties": true
    },
    "graphNode": {
      "type": "object",
      "required": [
        "@type",
        "@id"
      ],
      "properties": {
        "@type": {
          "$ref": "#/$defs/typeValue"
        },
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "@type": {
                    "const": "FAQPage"
                  }
                },
                "required": [
                  "@type"
                ]
              },
              {
                "properties": {
                  "@type": {
                    "type": "array",
                    "contains": {
                      "const": "FAQPage"
                    }
                  }
                },
                "required": [
                  "@type"
                ]
              }
            ]
          },
          "then": {
            "$ref": "#/$defs/faqPage"
          }
        }
      ],
      "additionalProperties": true
    },
    "graphDocument": {
      "type": "object",
      "required": [
        "@context",
        "@graph"
      ],
      "properties": {
        "@context": {
          "$ref": "#/$defs/context"
        },
        "@graph": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/graphNode"
          },
          "contains": {
            "$ref": "#/$defs/faqPage"
          },
          "minContains": 1
        }
      },
      "additionalProperties": true
    }
  }
}